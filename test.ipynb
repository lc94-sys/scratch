query = "Customer is in military"

# Get query embedding
query_emb = retriever.get_embedding(query)
query_emb = query_emb.reshape(1, -1).astype('float32')
faiss.normalize_L2(query_emb)

# Search FAISS
scores, indices = retriever.faiss_index.search(query_emb, 5)

print("FAISS Search Results:")
print("="*60)

for rank, (score, idx) in enumerate(zip(scores[0], indices[0]), 1):
    chunk = retriever.chunks[idx]
    
    # Re-compute similarity manually for this chunk
    chunk_emb = retriever.get_embedding(chunk['content'][:500])
    manual_sim = cosine_sim(query_emb.flatten(), chunk_emb)
    
    print(f"{rank}. FAISS index: {idx}")
    print(f"   Title: {chunk['title']}")
    print(f"   FAISS score: {score:.4f}")
    print(f"   Manual similarity: {manual_sim:.4f}")
    print(f"   Match: {'✓' if abs(score - manual_sim) < 0.1 else '✗ MISMATCH!'}")
    print()
