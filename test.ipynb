# =============================================================================
# BULK INDEXING FROM FOLDER
# =============================================================================

@router.post("/index/from-folder", response_model=ChunkAndIndexResponse)
async def index_documents_from_folder(
    folder_path: str = None,
    create_new_index: bool = False
):
    """
    Read all DOCX files from a folder and index them to OpenSearch.
    
    This endpoint:
    1. Reads all .docx files from the specified folder (or default raw_docs_path)
    2. Extracts text and tables from each document
    3. Chunks the documents semantically
    4. Creates embeddings and indexes to OpenSearch
    
    Note: OpenSearch handles BOTH vector search (replaces FAISS) and 
    text search (replaces BM25) - no separate indexes needed.
    
    Args:
        folder_path: Path to folder containing .docx files (optional, uses config default)
        create_new_index: If True, delete and recreate the index
    """
    import os
    from pathlib import Path
    
    try:
        # Use provided path or default from config
        docs_folder = folder_path or settings.raw_docs_path
        
        if not os.path.exists(docs_folder):
            raise HTTPException(
                status_code=400, 
                detail=f"Folder not found: {docs_folder}"
            )
        
        # Find all .docx files in folder
        docx_files = list(Path(docs_folder).glob("*.docx"))
        
        if not docx_files:
            return ChunkAndIndexResponse(
                success=False,
                message=f"No .docx files found in {docs_folder}",
                documents_processed=0,
                chunks_created=0,
                chunks_indexed=0
            )
        
        # Build metadata for each document
        documents_metadata = []
        for docx_file in docx_files:
            doc_name = docx_file.stem  # filename without extension
            
            documents_metadata.append({
                'file': docx_file.name,
                'entitlement': ['universal'],  # Default to universal access
                'metadata': {'tags': []},
                'orgId': '',
                'title': doc_name.replace('_', ' ').replace('-', ' ').title(),
                'summary': ''
            })
        
        # Process and index
        processor = get_document_processor()
        pipeline = get_chunking_pipeline()
        
        # Process documents
        processed_docs = processor.process_all(documents_metadata)
        
        if not processed_docs:
            return ChunkAndIndexResponse(
                success=False,
                message="Failed to process documents",
                documents_processed=0,
                chunks_created=0,
                chunks_indexed=0
            )
        
        # Chunk and index to OpenSearch
        result = pipeline.process_and_index(
            processed_documents=processed_docs,
            create_new_index=create_new_index
        )
        
        return ChunkAndIndexResponse(
            success=True,
            message=f"Indexed {len(docx_files)} documents from {docs_folder}",
            documents_processed=result['documents_processed'],
            chunks_created=result['chunks_created'],
            chunks_indexed=result['chunks_indexed']
        )
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/index/from-folder-with-metadata", response_model=ChunkAndIndexResponse)
async def index_documents_from_folder_with_metadata(
    folder_path: str = None,
    metadata_file: str = "metadata.json",
    create_new_index: bool = False
):
    """
    Read documents from folder using a metadata.json file for document info.
    
    The metadata.json should contain:
    ```json
    [
        {
            "file": "cancellation_procedure.docx",
            "entitlement": ["agent_support", "agent_manager"],
            "metadata": {"tags": ["cancellation", "refund"]},
            "orgId": "org_123",
            "title": "Cancellation Procedure",
            "summary": "Guidelines for processing cancellations"
        },
        ...
    ]
    ```
    
    Args:
        folder_path: Path to folder containing .docx files and metadata.json
        metadata_file: Name of metadata JSON file (default: metadata.json)
        create_new_index: If True, delete and recreate the index
    """
    import os
    import json
    
    try:
        docs_folder = folder_path or settings.raw_docs_path
        metadata_path = os.path.join(docs_folder, metadata_file)
        
        if not os.path.exists(docs_folder):
            raise HTTPException(status_code=400, detail=f"Folder not found: {docs_folder}")
        
        if not os.path.exists(metadata_path):
            raise HTTPException(
                status_code=400, 
                detail=f"Metadata file not found: {metadata_path}. Use /index/from-folder for auto-detection."
            )
        
        # Load metadata
        with open(metadata_path, 'r') as f:
            documents_metadata = json.load(f)
        
        if not documents_metadata:
            return ChunkAndIndexResponse(
                success=False,
                message="No documents defined in metadata file",
                documents_processed=0,
                chunks_created=0,
                chunks_indexed=0
            )
        
        # Process and index
        processor = get_document_processor()
        pipeline = get_chunking_pipeline()
        
        processed_docs = processor.process_all(documents_metadata)
        
        if not processed_docs:
            return ChunkAndIndexResponse(
                success=False,
                message="Failed to process documents",
                documents_processed=0,
                chunks_created=0,
                chunks_indexed=0
            )
        
        result = pipeline.process_and_index(
            processed_documents=processed_docs,
            create_new_index=create_new_index
        )
        
        return ChunkAndIndexResponse(
            success=True,
            message=f"Indexed {len(documents_metadata)} documents with metadata",
            documents_processed=result['documents_processed'],
            chunks_created=result['chunks_created'],
            chunks_indexed=result['chunks_indexed']
        )
        
    except HTTPException:
        raise
    except json.JSONDecodeError as e:
        raise HTTPException(status_code=400, detail=f"Invalid metadata JSON: {e}")
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# =============================================================================
# S3 INDEXING
# =============================================================================

class S3ChunksIndexRequest(BaseModel):
    """Request to index chunks from S3"""
    s3_bucket: str = Field(..., description="S3 bucket name")
    s3_key: str = Field(..., description="S3 key (path) to chunks JSON file")
    create_new_index: bool = Field(default=False, description="Delete and recreate index")


class S3ChunksIndexResponse(BaseModel):
    """Response from S3 indexing"""
    success: bool
    message: str
    chunks_loaded: int
    chunks_indexed: int
    chunks_failed: int


@router.post("/index/from-s3", response_model=S3ChunksIndexResponse)
async def index_chunks_from_s3(request: S3ChunksIndexRequest):
    """
    Load pre-computed chunks from S3 and index them to OpenSearch.
    
    This endpoint:
    1. Reads chunks JSON from S3
    2. Generates embeddings for each chunk
    3. Indexes to OpenSearch
    
    Expected S3 JSON format (array of chunks):
    ```json
    [
        {
            "chunk_id": "chunk_000001",
            "doc_id": "cancellation_procedure",
            "content": "The cancellation policy states that...",
            "title": "Cancellation Procedure",
            "entitlement": ["agent_support", "universal"],
            "org_id": "org_123",
            "tags": ["cancellation", "refund"],
            "summary": "Guidelines for cancellations"
        },
        ...
    ]
    ```
    
    Required fields: content
    Optional fields: chunk_id, doc_id, title, entitlement, org_id, tags, summary
    """
    import json
    import boto3
    
    try:
        # Get S3 client
        s3_client = boto3.client('s3', region_name=settings.aws_region)
        
        # Download chunks from S3
        try:
            response = s3_client.get_object(Bucket=request.s3_bucket, Key=request.s3_key)
            chunks_data = json.loads(response['Body'].read().decode('utf-8'))
        except s3_client.exceptions.NoSuchBucket:
            raise HTTPException(status_code=400, detail=f"S3 bucket not found: {request.s3_bucket}")
        except s3_client.exceptions.NoSuchKey:
            raise HTTPException(status_code=400, detail=f"S3 key not found: {request.s3_key}")
        except json.JSONDecodeError as e:
            raise HTTPException(status_code=400, detail=f"Invalid JSON in S3 file: {e}")
        
        if not chunks_data:
            return S3ChunksIndexResponse(
                success=False,
                message="No chunks found in S3 file",
                chunks_loaded=0,
                chunks_indexed=0,
                chunks_failed=0
            )
        
        # Validate chunks have content
        valid_chunks = [c for c in chunks_data if c.get('content')]
        if not valid_chunks:
            raise HTTPException(status_code=400, detail="No chunks with 'content' field found")
        
        # Get services
        opensearch_client = get_opensearch_client()
        embedding_model = get_embedding_model()
        
        # Create index if needed
        if request.create_new_index:
            opensearch_client.create_index(delete_if_exists=True)
        else:
            opensearch_client.create_index(delete_if_exists=False)
        
        # Generate embeddings and prepare for indexing
        chunks_with_embeddings = []
        for i, chunk in enumerate(valid_chunks):
            try:
                embedding = embedding_model.get_embedding(chunk['content'])
                
                chunks_with_embeddings.append({
                    'chunk_id': chunk.get('chunk_id', f"chunk_{i:06d}"),
                    'doc_id': chunk.get('doc_id', ''),
                    'content': chunk['content'],
                    'embedding': embedding,
                    'title': chunk.get('title', ''),
                    'entitlement': chunk.get('entitlement', ['universal']),
                    'org_id': chunk.get('org_id', chunk.get('orgId', '')),
                    'tags': chunk.get('tags', []),
                    'summary': chunk.get('summary', '')
                })
                
                if (i + 1) % 50 == 0:
                    print(f"  Embedded {i + 1}/{len(valid_chunks)} chunks")
                    
            except Exception as e:
                print(f"Error embedding chunk {i}: {e}")
        
        # Bulk index to OpenSearch
        result = opensearch_client.bulk_index(chunks_with_embeddings)
        
        return S3ChunksIndexResponse(
            success=True,
            message=f"Indexed chunks from s3://{request.s3_bucket}/{request.s3_key}",
            chunks_loaded=len(valid_chunks),
            chunks_indexed=result['indexed'],
            chunks_failed=result['failed']
        )
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/index/from-s3-folder", response_model=S3ChunksIndexResponse)
async def index_chunks_from_s3_folder(
    s3_bucket: str,
    s3_prefix: str = "",
    file_pattern: str = "*.json",
    create_new_index: bool = False
):
    """
    Load chunks from multiple JSON files in an S3 folder.
    
    Args:
        s3_bucket: S3 bucket name
        s3_prefix: S3 prefix/folder path (e.g., "chunks/" or "data/chunks/")
        file_pattern: File pattern to match (default: *.json)
        create_new_index: Delete and recreate index
    
    This will:
    1. List all JSON files in the S3 prefix
    2. Load and combine all chunks
    3. Generate embeddings
    4. Index to OpenSearch
    """
    import json
    import boto3
    from fnmatch import fnmatch
    
    try:
        s3_client = boto3.client('s3', region_name=settings.aws_region)
        
        # List objects in S3 prefix
        paginator = s3_client.get_paginator('list_objects_v2')
        all_chunks = []
        files_processed = 0
        
        for page in paginator.paginate(Bucket=s3_bucket, Prefix=s3_prefix):
            for obj in page.get('Contents', []):
                key = obj['Key']
                filename = key.split('/')[-1]
                
                # Match file pattern
                if fnmatch(filename, file_pattern):
                    try:
                        response = s3_client.get_object(Bucket=s3_bucket, Key=key)
                        chunks_data = json.loads(response['Body'].read().decode('utf-8'))
                        
                        # Handle both array and single object
                        if isinstance(chunks_data, list):
                            all_chunks.extend(chunks_data)
                        else:
                            all_chunks.append(chunks_data)
                        
                        files_processed += 1
                        print(f"  Loaded {key}: {len(chunks_data) if isinstance(chunks_data, list) else 1} chunks")
                        
                    except Exception as e:
                        print(f"  Error loading {key}: {e}")
        
        if not all_chunks:
            return S3ChunksIndexResponse(
                success=False,
                message=f"No chunks found in s3://{s3_bucket}/{s3_prefix}",
                chunks_loaded=0,
                chunks_indexed=0,
                chunks_failed=0
            )
        
        # Filter valid chunks
        valid_chunks = [c for c in all_chunks if c.get('content')]
        
        # Get services
        opensearch_client = get_opensearch_client()
        embedding_model = get_embedding_model()
        
        # Create index
        if create_new_index:
            opensearch_client.create_index(delete_if_exists=True)
        else:
            opensearch_client.create_index(delete_if_exists=False)
        
        # Generate embeddings
        chunks_with_embeddings = []
        for i, chunk in enumerate(valid_chunks):
            try:
                embedding = embedding_model.get_embedding(chunk['content'])
                
                chunks_with_embeddings.append({
                    'chunk_id': chunk.get('chunk_id', f"chunk_{i:06d}"),
                    'doc_id': chunk.get('doc_id', ''),
                    'content': chunk['content'],
                    'embedding': embedding,
                    'title': chunk.get('title', ''),
                    'entitlement': chunk.get('entitlement', ['universal']),
                    'org_id': chunk.get('org_id', chunk.get('orgId', '')),
                    'tags': chunk.get('tags', []),
                    'summary': chunk.get('summary', '')
                })
                
                if (i + 1) % 50 == 0:
                    print(f"  Embedded {i + 1}/{len(valid_chunks)} chunks")
                    
            except Exception as e:
                print(f"Error embedding chunk {i}: {e}")
        
        # Bulk index
        result = opensearch_client.bulk_index(chunks_with_embeddings)
        
        return S3ChunksIndexResponse(
            success=True,
            message=f"Indexed {files_processed} files from s3://{s3_bucket}/{s3_prefix}",
            chunks_loaded=len(valid_chunks),
            chunks_indexed=result['indexed'],
            chunks_failed=result['failed']
        )
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
