query = "Customer is in military"

# 1. Get query embedding
query_emb = retriever.get_embedding(query)

# 2. Find the military doc chunk and get its embedding directly
military_chunk_idx = None
for i, chunk in enumerate(retriever.chunks):
    if 'military' in chunk['title'].lower():
        military_chunk_idx = i
        print(f"Found military chunk at index: {i}")
        print(f"Title: {chunk['title']}")
        break

# 3. Get the stored embedding from your embeddings.npy
stored_embeddings = np.load('path/to/embeddings.npy')  # Update path
stored_military_emb = stored_embeddings[military_chunk_idx]

# 4. Compute fresh embedding for same chunk
fresh_military_emb = retriever.get_embedding(retriever.chunks[military_chunk_idx]['content'])

# 5. Compare all three
from numpy import dot
from numpy.linalg import norm

def cosine_sim(a, b):
    return dot(a, b) / (norm(a) * norm(b))

print("\n" + "="*60)
print("DIAGNOSIS:")
print("="*60)

sim_query_to_stored = cosine_sim(query_emb, stored_military_emb)
sim_query_to_fresh = cosine_sim(query_emb, fresh_military_emb)
sim_stored_to_fresh = cosine_sim(stored_military_emb, fresh_military_emb)

print(f"Query → Stored embedding:  {sim_query_to_stored:.4f}")
print(f"Query → Fresh embedding:   {sim_query_to_fresh:.4f}")
print(f"Stored → Fresh embedding:  {sim_stored_to_fresh:.4f}")

if sim_stored_to_fresh < 0.99:
    print("\n❌ PROBLEM: Stored and fresh embeddings don't match!")
    print("   Your embedding model is not deterministic or something changed.")
else:
    print("\n✓ Embeddings match")
