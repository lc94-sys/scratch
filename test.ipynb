query = "Customer is in military"

# Get embeddings
query_emb = retriever.get_embedding(query)

# Get embedding for a snippet from CORRECT document (military doc)
correct_doc_text = "YOUR CORRECT MILITARY DOC CONTENT HERE (first 500 chars)"
correct_emb = retriever.get_embedding(correct_doc_text)

# Get embedding for a snippet from WRONG document (dispute doc)  
wrong_doc_text = "YOUR WRONG DISPUTE DOC CONTENT HERE (first 500 chars)"
wrong_emb = retriever.get_embedding(wrong_doc_text)

# Calculate cosine similarity manually
from numpy import dot
from numpy.linalg import norm

def cosine_sim(a, b):
    return dot(a, b) / (norm(a) * norm(b))

sim_correct = cosine_sim(query_emb, correct_emb)
sim_wrong = cosine_sim(query_emb, wrong_emb)

print(f"Query: {query}")
print(f"Similarity to CORRECT (military) doc: {sim_correct:.4f}")
print(f"Similarity to WRONG (dispute) doc:   {sim_wrong:.4f}")
print()
if sim_correct > sim_wrong:
    print("✓ Embedding similarity is CORRECT")
else:
    print("✗ Embedding similarity is WRONG - this is the problem!")
